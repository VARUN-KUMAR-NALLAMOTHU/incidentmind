# --- Hindsight (Vectorize). Real Hindsight is the default memory backend. ---
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=hsk_02a19556f7f2fdea5fc781c420241800_1773bca045f75119
HINDSIGHT_BANK_ID=incidentmind-demo

# Only set this to true if you want the app to answer recall/reflect from a local SQLite store when
# Hindsight is unreachable. Default is false, so a broken Hindsight connection is visible, not hidden.
USE_LOCAL_FALLBACK=false

# A recalled memory older than this many days is flagged "stale" in the UI and the LLM prompt.
STALE_DAYS=90

# --- LLM (Groq). Leave empty to run the deterministic mock engine so the UI still works. ---
GROQ_API_KEY=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
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3-32b
LLM_RETRIES=2

CORS_ORIGINS=http://localhost:5173
